# ============================================================
# Lumia — Variables d'environnement
# Copier vers .env :  cp .env.example .env
# Le fichier .env est ignoré par Git ET par Docker (.dockerignore).
# ============================================================

# --- Application (runtime, côté serveur — SECRET) ---
# Clé API Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=VOTRE-API-KEY-ICI

# --- Supabase (inlinées au BUILD dans le bundle client) ---
# Valeurs "publiques" par design : la sécurité des données repose sur
# les Row Level Security policies côté Supabase, pas sur ces clés.
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-anon-key-ici

# --- Production uniquement (VPS) ---
# Domaine principal de l'app (ex: lumia-app.fr)
LUMIA_DOMAIN=lumia.example.com
# Identifiants admin Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changez-moi
# Webhook Discord pour les alertes Alertmanager (SECRET)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
